# 模板文件 —— 只放占位符,会被提交到 git。真实密钥写进 .env(已被 .gitignore 忽略)。
#   cp .env.example .env      然后编辑 .env 填入真实值
#
# 启动方式:
#   set -a && source .env && set +a
#   uvicorn app:app --port 8000

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# ---- MySQL(库不存在会自动创建)----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=learning_partner
